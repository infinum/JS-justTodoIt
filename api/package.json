{
	"name": "backend",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"engines": {
		"node": ">=22.21.1 <23.0.0"
	},
	"scripts": {
		"build": "tsup",
		"start": "pnpm tsx watch --env-file=.env src/index.ts",
		"start:prod": "node -r dotenv/config dist/index.js",
		"test:lint": "eslint src --ext .ts",
		"test:lint:fix": "eslint src --ext .ts --fix",
		"typeorm": "node --loader ts-node/esm node_modules/typeorm/cli.js -d src/data-source.ts",
		"migration:generate": "npm run typeorm -- migration:generate",
		"migration:run": "npm run typeorm -- migration:run",
		"migration:revert": "npm run typeorm -- migration:revert"
	},
	"dependencies": {
		"@tsed/ajv": "^8.14.1",
