		"@tsed/platform-express": "^8.14.1",
		"@tsed/schema": "^8.14.1",
		"@tsed/swagger": "^8.14.1",
		"@tsed/typeorm": "^7.85.1",
		"@types/swagger-schema-official": "^2.0.25",
		"ajv": "^8.17.1",
		"bcrypt": "^6.0.0",
		"body-parser": "^2.2.1",
