{
	"name": "backend",
	"version": "1.0.0",
	"description": "",
	"engines": {
		"node": ">=22.21.1 <23.0.0"
	},
	"scripts": {
		"build": "rm -rf dist && npm run tsc && npm run copy-package",
		"tsc": "tsc --project tsconfig.compile.json",
		"tsc:w": "tsc --project tsconfig.json -w",
		"copy-package": "cp package.json dist/package.json && cp package-lock.json dist/package-lock.json",
		"start": "nodemon --watch \"src/**/*.ts\" --ignore \"node_modules/**/*\" --exec ts-node -r dotenv/config src/index.ts",
		"start:prod": "cross-env NODE_ENV=production node dist/index.js",
		"test:lint": "eslint src --ext .ts",
		"test:lint:fix": "eslint src --ext .ts --fix",
		"typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
		"migration:generate": "npm run typeorm -- migration:generate",
		"migration:run": "npm run typeorm -- migration:run",
		"migration:revert": "npm run typeorm -- migration:revert"
	},
	"dependencies": {
		"@tsed/ajv": "^8.14.1",
		"@tsed/common": "^8.14.1",
		"@tsed/core": "^8.14.1",
		"@tsed/di": "^8.14.1",
		"@tsed/exceptions": "^8.14.1",
		"@tsed/platform-express": "^8.14.1",
		"@tsed/schema": "^8.14.1",
		"@tsed/swagger": "^8.14.1",
		"@tsed/typeorm": "^7.85.1",
		"@types/swagger-schema-official": "^2.0.25",
		"ajv": "^8.17.1",
		"bcrypt": "^6.0.0",
		"body-parser": "^2.2.0",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"cross-env": "^10.0.0",
		"express": "^5.1.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"method-override": "^3.0.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"resend": "^4.7.0",
		"sqlite3": "^5.1.7",
		"tslib": "^2.8.1",
		"typeorm": "^0.3.25"
	},
	"devDependencies": {
		"@tsed/cli-plugin-eslint": "^6.6.0",
		"@tsed/cli-plugin-typeorm": "^6.6.0",
		"@types/bcrypt": "^6.0.0",
		"@types/body-parser": "^1.19.6",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/method-override": "^3.0.0",
		"@types/node": "^24.1.0",
		"@types/react": "^19.1.9",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"concurrently": "^9.2.0",
		"dotenv": "^17.2.1",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.3",
		"nodemon": "^3.1.10",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	},
	"packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402"
}
