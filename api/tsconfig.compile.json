{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",
		"moduleResolution": "bundler",
		"composite": true,
		"declaration": true,
		"noResolve": false,
		"preserveConstEnums": true,
		"sourceMap": true,
		"noEmit": false,
		"inlineSources": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	}
}
